<?xml version='1.0' encoding='utf-8'?>
<widget id="com.chatly.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Chatly</name>
    <description>Secure Discord-like Chat Platform with End-to-End Encryption</description>
    <author email="team@chatly.io" href="https://chatly.io">Chatly Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <preference name="AndroidExtraPackages" value="androidx.appcompat,androidx.constraintlayout,androidx.lifecycle,androidx.savedstate,androidx.webkit" />
        <preference name="android-minSdkVersion" value="21" />
        <preference name="android-targetSdkVersion" value="34" />
        <icon density="ldpi" src="res/android/icon-36.png" />
        <icon density="mdpi" src="res/android/icon-48.png" />
        <icon density="hdpi" src="res/android/icon-72.png" />
        <icon density="xhdpi" src="res/android/icon-96.png" />
        <icon density="xxhdpi" src="res/android/icon-144.png" />
        <icon density="xxxhdpi" src="res/android/icon-192.png" />
    </platform>
    <platform name="ios">
        <icon height="57" src="res/ios/icon-57.png" width="57" />
        <icon height="72" src="res/ios/icon-72.png" width="72" />
        <icon height="114" src="res/ios/icon-114.png" width="114" />
        <icon height="144" src="res/ios/icon-144.png" width="144" />
    </platform>
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidExtraPackages" value="androidx.appcompat,androidx.constraintlayout,androidx.lifecycle,androidx.savedstate,androidx.webkit" />
    <preference name="android-minSdkVersion" value="21" />
    <preference name="android-targetSdkVersion" value="34" />
    <engine name="android" spec="^13.0.0" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.4" />
    <plugin name="cordova-plugin-statusbar" spec="^2.4.3" />
    <plugin name="cordova-plugin-device" spec="^2.0.3" />
    <plugin name="cordova-plugin-splashscreen" spec="^5.0.3" />
    <plugin name="cordova-plugin-ionic-webview" spec="^5.0.0" />
</widget>